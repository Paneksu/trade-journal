# Polaczenie do PostgreSQL (Coolify: uzyj adresu wewnetrznego kontenera)
DATABASE_URL=postgresql://journal:haslo@localhost:5432/journal

# Sekret do podpisywania ciasteczka sesji. Wygeneruj: openssl rand -base64 48
SESSION_SECRET=zmien-mnie-na-losowy-ciag-min-32-znaki

# Haslo do pierwszego logowania. Uzywane tylko przez `npm run seed`.
OWNER_PASSWORD=zmien-przed-seedem

# Klucz szyfrujacy sekret 2FA (TOTP) w bazie (ADR-031). 32 losowe bajty: base64url (43 znaki)
# albo hex (64 znaki). Wygeneruj:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Oznacz w Coolify jako secret. Bez zmiennej 2FA nie da sie wlaczyc (logowanie haslem dziala).
# OPCJONALNA: pusta = klucz 2FA jest wyprowadzany z SESSION_SECRET (HKDF, ADR-031); wtedy zmiana
# SESSION_SECRET po wlaczeniu 2FA tez unieważnia sekret.
# NIE ZMIENIAJ po wlaczeniu 2FA: sekret zapisany starym kluczem przestanie sie odszyfrowywac
# i logowanie kodem bedzie niemozliwe (awaryjnie: kod zapasowy tez nie pomoze - zmiana klucza
# wymaga wylaczenia 2FA w bazie, patrz docs/wdrozenie-coolify.md sekcja 9).
# Kody zapasowe tez sa liczone z tego klucza.
TOTP_ENC_KEY=

# Katalog na wgrywane zrzuty ekranu (w Dockerze: wolumen)
UPLOADS_DIR=./.dane/zrzuty

# API synchronizacji /api/ingest (ADR-026) - OPCJONALNE. Brak zmiennej = API wylaczone
# (kazda trasa odpowiada 404). Tu trafia WYLACZNIE skrot SHA-256 tokenu (64 znaki hex);
# sam token zostaje u klienta (repo mozgu, plik poza gitem), nigdy na serwerze.
#   token:  node -e "console.log('tj_' + require('crypto').randomBytes(32).toString('base64url'))"
#   skrot:  node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" <token>
# Oznacz w Coolify jako secret. Rotacja = nowy skrot w zmiennej + restart.
INGEST_TOKEN_SHA256=

# API v2 /api/v2 (ADR-030) - tokeny urzadzen w bazie, logowanie kodem urzadzenia (`tj login`).
# Nie wymaga zadnej zmiennej. Ponizsze sa OPCJONALNE:
#   API_V2_DISABLED=1   wylacznik awaryjny: kazda trasa /api/v2 odpowiada 404 (restart aplikacji)
#   APP_PUBLIC_URL=https://dziennik.panekweb.pl   adres, pod ktorym uzytkownik przepisuje kod urzadzenia
#                       (za proxy host z zadania bywa wewnetrzny; bez tej zmiennej uzywamy X-Forwarded-Host)
#   DEVICE_LOGIN_DISABLED=1   dodatkowy wylacznik logowania NOWYCH urzadzen (device/start); istniejace tokeny dzialaja.
#                             Bez tego urzadzenia sa i tak zamkniete do wlaczenia 2FA (ADR-030, kod 403 device_login_requires_2fa).
#                       (zatwierdzenie urzadzenia wymaga sudo albo hasla; to przelacznik awaryjny)
API_V2_DISABLED=
DEVICE_LOGIN_DISABLED=
APP_PUBLIC_URL=
